{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "noImplicitAny": false,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@atoms": ["./src/atoms"],
      "@atoms/*": ["./src/atoms/*"],
      "@constants": ["./src/constants"],
      "@constants/*": ["./src/constants/*"],
      "@components": ["./src/components"],
      "@components/*": ["./src/components/*"],
      "@hooks": ["./src/hooks"],
      "@hooks/*": ["./src/hooks/*"],
      "@locales": ["./src/locales"],
      "@locales/*": ["./src/locales/*"],
      "@providers": ["./src/providers"],
      "@providers/*": ["./src/providers/*"],
      "@scripts": ["./src/scripts"],
      "@scripts/*": ["./src/scripts/*"],
      "@themes": ["./src/themes"],
      "@themes/*": ["./src/themes/*"],
      "@app-types": ["./src/types"],
      "@app-types/*": ["./src/types/*"],
      "@utils": ["./src/utils"],
      "@utils/*": ["./src/utils/*"],
    }
  },
  "include": ["src/**/*", ".storybook/**/*"],
  "exclude": ["node_modules", "dist"],
  "extends": "expo/tsconfig.base"
}
