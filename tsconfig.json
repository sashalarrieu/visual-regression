{
  "compilerOptions": {
    "paths": {
      "@setshao/visual-regression": ["./src/index.ts"],
      "@setshao/visual-regression/storybook": ["./src/storybook/index.ts"]
    },
    "strict": true,
    "noEmit": true,
    "noImplicitAny": false,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["src/**/*", ".storybook/**/*"],
  "exclude": ["node_modules", "dist"],
  "extends": "expo/tsconfig.base"
}
