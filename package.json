{
  "name": "@setshao/visual-regression",
  "version": "1.3.0",
  "description": "Interface de régression visuelle pour Storybook (React Native / Expo), réutilisable dans tout projet",
  "type": "module",
  "main": "src/index.tsx",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./types": {
      "types": "./src/types/types.ts",
      "default": "./src/types/types.ts"
    },
    "./storybook": {
      "types": "./src/storybook/index.ts",
      "default": "./src/storybook/index.ts"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "visual-regression": "./bin/visual-regression.mjs"
  },
  "files": [
    "bin",
    "src",
    "docker",
    "assets",
    "app.config.js",
    "metro.config.cjs",
    "babel.config.cjs",
    "tsconfig.json",
    "tsconfig.cli.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "visual-regression",
    "storybook",
    "react-native",
    "expo",
    "screenshot",
    "testing"
  ],
  "author": "Sasha Larrieu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sashalarrieu/visual-regression.git"
  },
  "bugs": {
    "url": "https://github.com/sashalarrieu/visual-regression/issues"
  },
  "homepage": "https://github.com/sashalarrieu/visual-regression#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "expo": {
    "install": {
      "exclude": [
        "eslint-config-expo",
        "eslint",
        "typescript",
        "@typescript-eslint/eslint-plugin",
        "@typescript-eslint/parser",
        "eslint-config-prettier",
        "eslint-plugin-react",
        "eslint-plugin-react-hooks",
        "eslint-plugin-storybook",
        "eslint-plugin-import",
        "eslint-plugin-prettier",
        "eslint-plugin-check-file",
        "eslint-plugin-import-helpers",
        "vitest",
        "husky",
        "lint-staged",
        "prettier",
        "storybook",
        "@storybook/react-webpack5",
        "@storybook/addon-react-native-web"
      ]
    }
  },
  "scripts": {
    "storybook": "cross-env STORYBOOK_ENV=web storybook dev -p 6006",
    "storybook:build": "cross-env STORYBOOK_ENV=web storybook build",
    "storybook:build:stats": "cross-env STORYBOOK_ENV=web storybook build --stats-json",
    "vr:storybook:static": "yarn storybook:build:stats && npx serve storybook-static -l 6006",
    "sync-vr": "node ../scripts/sync-vr-and-start.mjs",
    "vr": "node bin/visual-regression.mjs",
    "vr:server": "node bin/visual-regression.mjs server",
    "vr:compare": "node bin/visual-regression.mjs compare",
    "vr:benchmark": "node bin/visual-regression.mjs benchmark",
    "vr:benchmark-shards": "node bin/visual-regression.mjs benchmark-shards",
    "vr:test-incremental": "node bin/visual-regression.mjs test-incremental",
    "vr:test-validation": "node bin/visual-regression.mjs test-validation",
    "vr:app": "node bin/visual-regression.mjs app",
    "vr:capture:up": "node bin/visual-regression.mjs capture-up",
    "vr:capture:down": "node bin/visual-regression.mjs capture-down",
    "vr:capture:status": "node bin/visual-regression.mjs capture-status",
    "vr:kill-ports": "node bin/visual-regression.mjs kill-ports",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ci": "vitest run",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "pack:verify": "node scripts/verify-pack.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "precommit": "lint-staged && yarn lint && yarn format:check && yarn typecheck",
    "prepublishOnly": "yarn precommit && yarn test:ci && npm run pack:check"
  },
  "lint-staged": {
    "**/*.{js,mjs,cjs,ts,jsx,tsx,gql,sql,md,css,scss,json}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "peerDependencies": {
    "@expo/vector-icons": "*",
    "expo-clipboard": "*",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-native": "*",
    "react-native-gesture-handler": "*",
    "react-native-reanimated": ">=4.1.0",
    "react-native-svg": "*",
    "react-native-worklets": ">=0.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.24.0",
    "@babel/preset-typescript": "^7.24.0",
    "@eslint/compat": "^1.2.4",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.17.0",
    "@expo/vector-icons": "15.0.3",
    "@storybook/addon-react-native-web": "0.0.29",
    "@storybook/react-webpack5": "10.4.6",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "~19.1.10",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "babel-loader": "^9.1.3",
    "babel-plugin-import-graphql": "^2.8.1",
    "babel-plugin-react-native-web": "^0.21.2",
    "bun": "^1.3.14",
    "eslint": "^9.17.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-check-file": "^3.3.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-import-helpers": "^1.3.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-storybook": "10.4.6",
    "expo-clipboard": "~8.0.8",
    "husky": "^9.1.7",
    "kill-port": "^2.0.1",
    "lint-staged": "^17.1.0",
    "prettier": "^3.9.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-svg": "15.12.1",
    "react-refresh": "^0.14.2",
    "storybook": "10.4.6",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "babel-preset-expo": "~54.0.11",
    "cross-env": "^7.0.3",
    "expo": "~54.0.35",
    "expo-font": "~14.0.12",
    "expo-updates": "~29.0.18",
    "lru-cache": "5.1.1",
    "yallist": "3.1.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-web": "^0.21.0",
    "react-native-reanimated": "~4.5.1",
    "react-native-worklets": "~0.10.1",
    "semver": "^7.7.3",
    "tsx": "^4.23.0"
  }
}
